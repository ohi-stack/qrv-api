# QR-V™ Production Architecture v1.0 — TRUSTED BACKEND / DATA NODE
# Runtime: https://api.qrv.network
# This service is the only production application allowed to own canonical
# registry persistence, privileged API operations, and backend secrets.

NODE_ENV=production
PORT=3000
APP_VERSION=2.0.0

# Canonical human-facing platform.
QRV_PLATFORM_ORIGIN=https://qrv.network

# Canonical PostgreSQL registry datastore. API node only.
# QR-V must have exactly one writable canonical registry authority.
DATABASE_URL=
DATABASE_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PGSSLMODE=require

# OPTIONAL FUTURE MIGRATION PATH — do not enable as a second competing authority.
# If Supabase replaces direct PostgreSQL/Cloud SQL, intentionally switch the
# persistence adapter and configure these server-side values here only:
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=

# Server-to-server write authorization shared only with qrv.network.
# Never expose this key to browser JavaScript.
QRV_PLATFORM_API_KEY=

# Browser access is restricted to explicitly approved origins.
CORS_ALLOWED_ORIGINS=https://qrv.network

# Public verification rate control.
PUBLIC_RATE_WINDOW_MS=60000
PUBLIC_RATE_LIMIT=240

# Future backend-only secret classes belong here when implemented:
# QRV_WEBHOOK_SECRET=
# JWT_SECRET=
# QRV_SIGNING_PRIVATE_KEY=
# QRV_SIGNING_KEY_ID=
# QRV_SIGNING_ALGORITHM=Ed25519

# Canonical API base (documentation only):
# https://api.qrv.network/api/v1
