# QR-V™ Production Architecture v1.0 — TRUSTED BACKEND / DATA NODE
# Runtime: https://api.qrv.network
# This service is the only production application allowed to own canonical
# registry persistence, privileged API operations, and backend secrets.

NODE_ENV=production
PORT=3000
APP_VERSION=2.1.0

# Canonical public/platform URLs.
QRV_API_BASE_URL=https://api.qrv.network
QRV_PUBLIC_BASE_URL=https://qrv.network
QRV_PLATFORM_ORIGIN=https://qrv.network
QRV_VERIFY_BASE_URL=https://qrv.network/verify
QRV_REGISTRY_BASE_URL=https://qrv.network/registry

# Select exactly ONE writable canonical registry authority.
# Supabase may host the canonical PostgreSQL database, but the current runtime
# still connects to that database through DATABASE_URL.
QRV_DATA_BACKEND=supabase-postgres

# Supabase project metadata / server credentials.
# SUPABASE_SECRET_KEY must never be exposed to browser JavaScript.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy Hostinger key name may remain temporarily if already configured, but
# new server code should prefer SUPABASE_SECRET_KEY.
SUPABASE_KEY=

# Runtime PostgreSQL connection for the SAME canonical datastore.
# When QRV_DATA_BACKEND=supabase-postgres, use the PostgreSQL connection string
# from the same Supabase project named by SUPABASE_URL. Do not point this at a
# second database.
DATABASE_URL=
DATABASE_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PGSSLMODE=require

# Server-to-server write authorization shared only with qrv.network.
# IMPORTANT: the current runtime reads QRV_PLATFORM_API_KEY.
# If Hostinger already has QRV_API_KEY, set QRV_PLATFORM_API_KEY to the same
# secret until runtime alias support is merged.
QRV_PLATFORM_API_KEY=
QRV_API_KEY=

# Separate webhook verification secret. Never reuse the API key.
QRV_WEBHOOK_SECRET=

# Browser access is restricted to explicitly approved origins.
# The current runtime reads CORS_ALLOWED_ORIGINS.
CORS_ALLOWED_ORIGINS=https://qrv.network
CORS_ORIGINS=https://qrv.network

LOG_LEVEL=info

# Public verification rate control.
PUBLIC_RATE_WINDOW_MS=60000
PUBLIC_RATE_LIMIT=240

# Backend-only signing/auth secret classes. Configure only when implemented.
# JWT_SECRET=
# QRV_SIGNING_PRIVATE_KEY=
# QRV_SIGNING_KEY_ID=
# QRV_SIGNING_ALGORITHM=Ed25519

# Canonical API base:
# https://api.qrv.network/api/v1
