# QR-V™ API — Hostinger production environment contract
# Runtime: https://api.qrv.network
# Keep all values secret in Hostinger. Never commit real credentials.

NODE_ENV=production
PORT=3000
APP_VERSION=2.0.0

# Canonical public/platform URLs.
QRV_PLATFORM_ORIGIN=https://qrv.network
QRV_API_BASE_URL=https://api.qrv.network/api/v1
QRV_PUBLIC_BASE_URL=https://qrv.network
QRV_VERIFY_BASE_URL=https://qrv.network/verify
QRV_REGISTRY_BASE_URL=https://qrv.network/registry

# Canonical registry datastore.
# Supabase may be the PostgreSQL provider, but the current qrv-api runtime connects
# directly to PostgreSQL through DATABASE_URL. SUPABASE_URL/keys do not replace it.
DATABASE_URL=
DATABASE_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PGSSLMODE=require

# Optional Supabase project metadata / future server integrations.
# A Supabase secret/server key must never be exposed to browser clients.
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy Hostinger variable may remain during migration if already configured.
SUPABASE_KEY=

# Server-to-server write authorization shared only with qrv.network.
# Current runtime canonical name:
QRV_PLATFORM_API_KEY=
# Hostinger compatibility name currently in use. Until runtime alias support is
# implemented, set QRV_PLATFORM_API_KEY to the same secret value.
QRV_API_KEY=

# Reserved for verified inbound webhook signatures. Do not reuse the API key.
QRV_WEBHOOK_SECRET=

# Browser access is restricted to explicitly trusted origins.
CORS_ALLOWED_ORIGINS=https://qrv.network

# Public verification rate control.
PUBLIC_RATE_WINDOW_MS=60000
PUBLIC_RATE_LIMIT=240

LOG_LEVEL=info
