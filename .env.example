NODE_ENV=production
PORT=3000
APP_VERSION=2.0.0

# Canonical QR-V origins.
QRV_API_BASE_URL=https://api.qrv.network
QRV_PUBLIC_BASE_URL=https://qrv.network
QRV_PLATFORM_ORIGIN=https://qrv.network
QRV_VERIFY_BASE_URL=https://qrv.network/verify
QRV_REGISTRY_BASE_URL=https://qrv.network/registry
QRV_ISSUER_BASE_URL=https://qrv.network/issuer

# Canonical registry datastore. qrv-api currently uses direct PostgreSQL.
DATABASE_URL=
DATABASE_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000
PGSSLMODE=require

# Server-to-server write authorization shared only with qrv.network platform node.
QRV_PLATFORM_API_KEY=
QRV_API_KEY=
QRV_WEBHOOK_SECRET=

# Browser access is restricted to the public platform.
CORS_ALLOWED_ORIGINS=https://qrv.network
CORS_ORIGINS=https://qrv.network

# Logging and public verification rate control.
LOG_LEVEL=info
PUBLIC_RATE_WINDOW_MS=60000
PUBLIC_RATE_LIMIT=240

# Supabase migration note:
# Do not set SUPABASE_URL / SUPABASE_SECRET_KEY as an additional writable authority
# unless qrv-api is explicitly migrated to a Supabase persistence adapter.
# Preferred server-side Supabase key name for a future migration:
# SUPABASE_URL=
# SUPABASE_SECRET_KEY=sb_secret_...
# Legacy SUPABASE_KEY should only be retained temporarily for compatibility during migration.
