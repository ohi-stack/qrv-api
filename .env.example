NODE_ENV=production
PORT=3000
APP_VERSION=2.0.0

# Two-node public architecture
QRV_PUBLIC_BASE_URL=https://qrv.network
QRV_API_BASE_URL=https://api.qrv.network/api/v1
QRV_ENV_CODE=PROD

# Canonical PostgreSQL registry
DATABASE_URL=
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=true
DATABASE_POOL_MAX=20
PG_CONNECTION_TIMEOUT_MS=5000
PG_IDLE_TIMEOUT_MS=10000

# Write authorization
QRV_WRITE_API_KEY=
QRV_DEFAULT_ISSUER_ID=

# Cryptographic signing
REQUIRE_SIGNATURES=true
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=

# Browser access: the single public platform origin
CORS_ALLOWED_ORIGINS=https://qrv.network

# API protection
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=180
