{
  "name": "qrv-api",
  "version": "2.1.0",
  "private": false,
  "type": "module",
  "description": "Canonical API and registry node for the consolidated QR-V Global Verification Network.",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "check": "node --check server.js && node --check scripts/migrate.js",
    "build": "echo Build complete",
    "migrate": "node scripts/migrate.js",
    "validate:prod": "npm run check && npm run build"
  },
  "keywords": ["qrv", "verification", "api", "registry", "qr"],
  "license": "MIT",
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "helmet": "^8.1.0",
    "pg": "^8.16.3"
  },
  "engines": {
    "node": ">=20"
  }
}
